# ─────────────────────────────────────────────────────────────
# Sitio (portafolio)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://portafolio-inky-rho.vercel.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=            # G-XXXXXXX (opcional)
NEXT_PUBLIC_WEB3FORMS_KEY=                # formulario de contacto (web3forms.com)

# ─────────────────────────────────────────────────────────────
# Content Engine (agente LangGraph). Guía: docs/setup.md
# ─────────────────────────────────────────────────────────────
# LLM principal: OpenCode Go (compatible con OpenAI)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=                                # un modelo de tu plan de OpenCode Go
# Respaldo opcional (cualquier API compatible con OpenAI)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Postgres (Supabase o Neon). Usa la URL con pooling y sslmode=require
DATABASE_URL=

# Telegram: token de @BotFather y tu chat id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=                  # openssl rand -hex 24

# Secretos propios
CRON_SECRET=                              # openssl rand -hex 24 (Vercel Cron lo envía solo)
ADMIN_SECRET=                             # openssl rand -hex 24 (protege /api/agent/setup y /api/linkedin/auth)
TOKEN_ENCRYPTION_KEY=                     # openssl rand -hex 32 (cifra el token de LinkedIn)

# GitHub: token fine-grained con "Contents: Read and write" solo en este repo
GITHUB_TOKEN=
GITHUB_REPO=MiguelBonilla-sys/portafolio
GITHUB_BRANCH=main

# LinkedIn: app en developer.linkedin.com con "Share on LinkedIn" y "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509               # YYYYMM de los últimos 12 meses

# Opcionales
# SITE_URL=                               # si es distinto de NEXT_PUBLIC_SITE_URL
# INDEXNOW_KEY=3a142bdab1da687057cc12b488c8e24c
# AGENT_TIMEZONE=America/Bogota
# DEPLOY_WAIT_SECONDS=180
# SHOW_DRAFTS=true                        # incluir borradores del blog en un build
