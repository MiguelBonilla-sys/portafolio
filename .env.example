# ─────────────────────────────────────────────────────────────
# Sitio (portafolio)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mangel14.dev
NEXT_PUBLIC_GA_MEASUREMENT_ID=            # G-XXXXXXX (opcional)
NEXT_PUBLIC_WEB3FORMS_KEY=                # formulario de contacto (web3forms.com)

# ─────────────────────────────────────────────────────────────
# Content Engine (agente LangGraph). Guía: docs/setup.md
# ─────────────────────────────────────────────────────────────
# LLM principal: OpenCode Go (compatible con OpenAI)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=                                # un modelo de tu plan de OpenCode Go
# Respaldo opcional (cualquier API compatible con OpenAI)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Opcional: modelo con visión del mismo proveedor para describir imágenes enviadas por Telegram.
# Sin él, el bot avisa que no puede leer imágenes en lugar de inventar su contenido.
LLM_VISION_MODEL=

# Postgres (Supabase o Neon). Usa la URL con pooling y sslmode=require
DATABASE_URL=

# Telegram: token de @BotFather y tu chat id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=                  # openssl rand -hex 24

# Secretos propios
CRON_SECRET=                              # openssl rand -hex 24 (Vercel Cron lo envía solo)
ADMIN_SECRET=                             # openssl rand -hex 24 (protege /api/agent/setup y /api/linkedin/auth)
TOKEN_ENCRYPTION_KEY=                     # openssl rand -hex 32 (cifra el token de LinkedIn)

# GitHub: token fine-grained con "Contents: Read and write" solo en este repo
GITHUB_TOKEN=
GITHUB_REPO=MiguelBonilla-sys/portafolio
GITHUB_BRANCH=main

# LinkedIn: app en developer.linkedin.com con "Share on LinkedIn" y "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608               # YYYYMM de los últimos 12 meses

# Tarjeta de contacto en Wallet (opcional; sin esto la tarjeta funciona con vCard + QR). Guía: docs/setup.md §10
# Los PEM pueden ir en base64 (base64 -w0 archivo.pem) o tal cual con \n
APPLE_WALLET_PASS_TYPE_ID=                # pass.dev.mangel14.card
APPLE_WALLET_TEAM_ID=                     # Team ID de Apple Developer (10 caracteres)
APPLE_WALLET_SIGNER_CERT=                 # certificado del Pass Type ID (PEM)
APPLE_WALLET_SIGNER_KEY=                  # su llave privada (PEM)
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=       # si la llave tiene contraseña
APPLE_WALLET_WWDR_CERT=                   # Apple WWDR G4 (PEM)
GOOGLE_WALLET_ISSUER_ID=                  # Google Pay & Wallet Console
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=      # ...@...iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY=                # private_key del JSON de la cuenta de servicio

# Opcionales
# SITE_URL=                               # si es distinto de NEXT_PUBLIC_SITE_URL
# INDEXNOW_KEY=3a142bdab1da687057cc12b488c8e24c
# AGENT_TIMEZONE=America/Bogota
# DEPLOY_WAIT_SECONDS=180
# SHOW_DRAFTS=true                        # incluir borradores del blog en un build
